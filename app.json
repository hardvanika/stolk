{
  "expo": {
    "name": "Stölk",
    "slug": "stolk",
    "scheme": "stolk",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EEF2F6",
    "ios": {
      "bundleIdentifier": "app.stolk.personal",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Stölk tags where you met someone. Your location stays on this phone."
      }
    },
    "android": {
      "package": "app.stolk.personal",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": [
      "expo-router",
      ["expo-location", { "locationWhenInUsePermission": "Stölk tags where you met someone. Your location stays on this phone." }],
      ["llama.rn", { "enableOpenCL": true }],
      ["expo-build-properties", { "android": { "minSdkVersion": 26 }, "ios": { "deploymentTarget": "16.4" } }]
    ]
  }
}
